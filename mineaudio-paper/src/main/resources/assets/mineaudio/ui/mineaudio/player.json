                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "text": "按 {key.mineaudio:open_ui} 打开音乐界面 · {key.mineaudio:toggle_hud} 切换 HUD；点播请用 /mineaudio play",
          "color": "#808080",
          "scale": 0.8
        },
        {
          "type": "row",
          "justify": "center",
          "children": [
            {
              "type": "button",
              "skin": "vanilla:button",
              "text": "关闭",
              "action": "close",
              "width": 70,
              "height": 18,
              "hoverScale": 1.08
            }
          ]
        }
      ]
