{
  "type": "stack",
  "width": "100%",
  "height": "100%",
  "align": "center",
  "justify": "center",
  "children": [
    {
      "type": "column",
      "skin": "vanilla:panel",
      "width": "92%",
      "gap": 6,
      "padding": 10,
      "align": "stretch",
      "children": [
        {
          "type": "row",
          "gap": 8,
          "align": "center",
          "children": [
            {
              "type": "item",
              "item": "minecraft:jukebox",
              "scale": 1.3
            },
            {
              "type": "text",
              "text": "MineAudio",
              "color": "#FFFFFF",
              "scale": 1.2
            },
            {
              "type": "text",
              "text": "{state.stream}",
              "color": "#909090",
              "scale": 0.85
            }
          ]
        },
        {
          "type": "box",
          "width": "100%",
          "height": 2,
          "gradient": [
            "#0000C8B4",
            "#FF00C8B4"
          ]
        },
        {
          "type": "row",
          "gap": 8,
          "align": "center",
          "padding": 6,
          "radius": 6,
          "background": "#22FFFFFF",
          "border": {
            "color": "#44FFFFFF",
            "width": 1
          },
          "children": [
            {
              "type": "stack",
              "width": 56,
              "height": 56,
              "children": [
                {
                  "type": "image",
                  "url": "{state.cover}",
                  "width": 56,
                  "height": 56,
                  "radius": 28,
                  "spin": 8.0,
                  "spinPlaying": "{state.playing}",
                  "visible": "{state.cover_visible}"
                },
                {
                  "type": "item",
                  "item": "minecraft:music_disc_cat",
                  "scale": 1.9,
                  "visible": "{state.cover_fallback}"
                }
              ]
            },
            {
              "type": "column",
              "gap": 2,
              "width": "82%",
              "children": [
                {
                  "type": "text",
                  "text": "{state.title}",
                  "color": "#FFFFFF",
                  "scale": 1.15
                },
                {
                  "type": "text",
                  "text": "{state.subtitle}",
                  "color": "#A0A0A0",
                  "scale": 0.85
                },
                {
                  "type": "row",
                  "gap": 5,
                  "align": "center",
                  "children": [
                    {
                      "type": "box",
                      "width": 6,
                      "height": 6,
                      "radius": 3,
                      "cycle": {
                        "interval": 0.5,
                        "colors": [
                          "#FF00E676",
                          "#3300E676"
                        ]
                      }
                    },
                    {
                      "type": "text",
                      "text": "{state.state}  {state.backend}  {state.origin}",
                      "color": "#7A7A7A",
                      "scale": 0.8
                    }
                  ]
                },
                {
                  "type": "column",
                  "width": "100%",
                  "gap": 2,
                  "visible": "{state.progress_visible}",
                  "children": [
                    {
                      "type": "progress",
                      "width": "100%",
                      "height": 8,
                      "radius": 4,
                      "background": "#40000000",
                      "fillGradient": [
                        "#00C8B4",
                        "#8A5FD0"
                      ],
                      "value": "{state.percent}",
                      "min": 0,
                      "max": 100,
                      "playing": "{state.playing}",
                      "interpolate": true,
                      "snap": 5
                    },
                    {
                      "type": "text",
                      "text": "{state.time}",
                      "color": "#909090",
                      "scale": 0.75
                    },
                    {
                      "type": "slider",
                      "skin": "vanilla:slider",
                      "width": "100%",
                      "height": 12,
                      "min": 0,
                      "max": 100,
                      "step": 1,
                      "value": "{state.percent}",
                      "text": "拖动定位",
                      "color": "#D0E0F0",
                      "action": "seek_to"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "row",
          "gap": 6,
          "justify": "center",
          "children": [
            {
              "type": "button",
              "skin": "vanilla:button",
              "text": "暂停",
              "action": "pause",
              "width": 56,
              "height": 18,
              "hoverScale": 1.08,
              "tooltip": "暂停当前音乐（NBS/流媒体支持）"
            },
            {
              "type": "button",
              "skin": "vanilla:button",
              "text": "继续",
              "action": "resume",
              "width": 56,
              "height": 18,
              "hoverScale": 1.08
            },
            {
              "type": "button",
              "skin": "vanilla:button",
              "text": "停止音乐",
              "action": "stop",
              "width": 74,
              "height": 18,
              "hoverScale": 1.08
            },
            {
              "type": "button",
              "skin": "vanilla:button",
              "text": "停止环境音",
              "action": "stop_ambient",
              "width": 82,
              "height": 18,
              "hoverScale": 1.08
            },
            {
              "type": "button",
              "skin": "vanilla:button",
              "text": "刷新",
              "action": "refresh",
              "width": 50,
              "height": 18,
              "hoverScale": 1.08
            }
          ]
        },
        {
          "type": "row",
          "gap": 6,
          "justify": "center",
          "children": [
            {
              "type": "button",
              "skin": "vanilla:button",
              "text": "-15s",
              "action": "seek_back",
              "width": 46,
              "height": 16,
              "hoverScale": 1.08,
              "tooltip": "后退 15 秒（仅流媒体客户端支持）"
            },
            {
              "type": "button",
              "skin": "vanilla:button",
              "text": "+15s",
              "action": "seek_fwd",
              "width": 46,
              "height": 16,
              "hoverScale": 1.08,
              "tooltip": "前进 15 秒（仅流媒体客户端支持）"
            },
            {
              "type": "button",
              "skin": "vanilla:button",
              "text": "音量 -",
              "action": "vol_down",
              "width": 56,
              "height": 16,
              "hoverScale": 1.08
            },
            {
              "type": "button",
              "skin": "vanilla:button",
              "text": "音量 +",
              "action": "vol_up",
              "width": 56,
              "height": 16,
              "hoverScale": 1.08
            },
            {
              "type": "text",
              "text": "{state.volume}",
              "color": "#C0C0C0",
              "scale": 0.8
            },
            {
              "type": "button",
              "skin": "vanilla:button",
              "text": "HUD",
              "action": "toggle_hud",
              "width": 44,
              "height": 16,
              "hoverScale": 1.08,
              "tooltip": "开启/关闭“正在播放”HUD"
            }
          ]
        },
        {
          "type": "text",
          "text": "{state.note}",
          "color": "#FFD54F",
          "scale": 0.85
        },
        {
          "type": "text",
          "text": "{state.status}",
          "color": "#FF8A65",
          "scale": 0.8,
          "visible": "{state.status_visible}"
        },
        {
          "type": "column",
          "gap": 3,
          "padding": 6,
          "radius": 6,
          "background": "#22FFFFFF",
          "children": [
            {
              "type": "text",
              "text": "曲目（自己 / 全服）",
              "color": "#C0C0C0",
              "scale": 0.9
            },
            {
              "type": "row",
              "gap": 6,
              "align": "center",
              "visible": "{state.t0_visible}",
              "children": [
                {
                  "type": "text",
                  "text": "{state.t0_name}",
                  "color": "#FFFFFF",
                  "scale": 0.9,
                  "width": "48%"
                },
                {
                  "type": "text",
                  "text": "{state.t0_bus}",
                  "color": "#808080",
                  "scale": 0.8,
                  "width": "12%"
                },
                {
                  "type": "text",
                  "text": "{state.t0_src}",
                  "color": "#00C8B4",
                  "scale": 0.8,
                  "width": "14%"
                },
                {
                  "type": "button",
                  "skin": "vanilla:button",
                  "text": "自己",
                  "action": "play_self0",
                  "width": 40,
                  "height": 16,
                  "hoverScale": 1.08
                },
                {
                  "type": "button",
                  "skin": "vanilla:button",
                  "text": "全服",
                  "action": "play_global0",
                  "width": 40,
                  "height": 16,
                  "hoverScale": 1.08
                }
              ]
            },
            {
              "type": "row",
