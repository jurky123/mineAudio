          ]
        },
        {
          "type": "column",
          "gap": 3,
          "padding": 6,
          "radius": 6,
          "background": "#22FFFFFF",
          "children": [
            {
              "type": "text",
              "text": "环境音（AMBIENT）",
              "color": "#C0C0C0",
              "scale": 0.9
            },
            {
              "type": "row",
              "gap": 6,
              "align": "center",
              "visible": "{state.a0_visible}",
              "children": [
                {
                  "type": "text",
                  "text": "{state.a0_name}",
                  "color": "#FFFFFF",
                  "scale": 0.9
                }
              ]
            },
            {
              "type": "row",
              "gap": 6,
              "align": "center",
